# Copy to .env and fill in your values.  Never commit .env.
GOOGLE_API_KEY=your-key-here
ENV=dev

# LiveKit API — matches docker/livekit/livekit.yaml dev credentials.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_WS_URL=ws://localhost:7880

# DEV_MODE=true enables CORS for http://localhost:5173 (the HTML tester).
# NEVER set to true in staging or production.
DEV_MODE=false
