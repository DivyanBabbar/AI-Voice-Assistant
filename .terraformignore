# .terraformignore
#
# Files excluded from Terraform module packages uploaded to a registry or remote
# workspace. This mirrors .gitignore but is evaluated by Terraform, not git.

# Python / Poetry artefacts
__pycache__/
*.py[cod]
*.pyo
.venv/
dist/
*.egg-info/

# Test and coverage output
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/

# Linter caches
.ruff_cache/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Git internals
.git/

# Terraform local state and provider cache (not needed in packages)
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.backup
**/.terraform.lock.hcl

# CI and secrets
.env
.env.*
*.pem
*.key

# Node (if ever added)
node_modules/
